  <build>


    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- A launch argument, not a system property set later: the JVM fixes
               its default locale at init and Format caches the currency symbol
               on first use. Without it 17 currency assertions read pounds. -->
          <!-- H2 and DuckDB run in this very JVM, so their data competes with
               the suite for the same heap; 4g dies with an OutOfMemoryError.
               The upper bound is the machine's, not the suite's: a database
               container and a tmpfs log directory want the rest. -->
          <argLine>-Xmx6g ${maven-failsafe-plugin.argLine} -Dlogback.configurationFile=${logback.config}</argLine>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>

    </plugins>
    <resources>
      <resource>
        <directory>${project.basedir}/testfiles</directory>
        <targetPath>${project.build.directory}/testfiles</targetPath>
      </resource>
      <resource>
        <directory>src/test/resources</directory>
        <targetPath>${project.build.directory}/test-classes</targetPath>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
  </build>

